# Copiá este archivo como .env.local y completá con tus datos reales
# (Supabase → Settings → API)

NEXT_PUBLIC_SUPABASE_URL=https://tu-proyecto.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=tu-anon-key-aqui

# Supabase → Settings → API → service_role key.
# SECRETA: nunca exponer al cliente, solo se usa server-side en el webhook de pagos
# para poder activar el perfil sin depender de una sesión de usuario.
SUPABASE_SERVICE_ROLE_KEY=tu-service-role-key-aqui

# URL pública del sitio (sin barra final). Mercado Pago la usa para las URLs de
# retorno y para el webhook de confirmación de pago. En local: http://localhost:3000
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Mercado Pago (Developers → Credenciales)
MERCADOPAGO_ACCESS_TOKEN=tu-access-token-aqui
NEXT_PUBLIC_MERCADOPAGO_PUBLIC_KEY=tu-public-key-aqui

# Datos bancarios para mostrar en el checkout (transferencia)
NEXT_PUBLIC_SCOTIA_CUENTA="Cuenta Scotiabank: 000-000000-0 (a nombre de ...)"
NEXT_PUBLIC_ITAU_CUENTA="Cuenta Itaú: 000-000000-0 (a nombre de ...)"

# Tu email de administrador (debe coincidir con el que pusiste en schema.sql)
ADMIN_EMAIL=tu-email@ejemplo.com
